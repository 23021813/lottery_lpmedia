# Cloudflare Turnstile Configuration
# Lấy từ Cloudflare Dashboard: https://dash.cloudflare.com/

# Site Key (cho client-side) - Để test: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Secret Key (cho server-side) - Để test: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here